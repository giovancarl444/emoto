<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0c0e">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {% render 'fonts' %}
    {% render 'meta-tags' %}
    {{ 'emoto.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    {% render 'structured-data' %}
  </head>
  <body>
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t: default: 'Hoppa till innehåll' }}</a>
    {% section 'announcement' %}
    {% section 'header' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% section 'cart-drawer' %}
    <script src="{{ 'showroom.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </body>
</html>
