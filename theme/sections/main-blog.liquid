{%- comment -%} EMOTO — blog listing (SEO content hub) {%- endcomment -%}
<section class="blog">
  <div class="container">
    <header class="blog__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Journal' }}</span>
      <h1 class="blog__title">{{ blog.title }}</h1>
    </header>

    {%- paginate blog.articles by 12 -%}
      <div class="blog__grid">
        {%- for article in blog.articles -%}
          <a class="acard" href="{{ article.url }}">
            {%- if article.image -%}
              <div class="acard__media">
                {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: article.title, class: 'acard__img' }}
              </div>
            {%- endif -%}
            <div class="acard__body">
              {%- if article.tags.size > 0 -%}<span class="acard__tag">{{ article.tags.first }}</span>{%- endif -%}
              <h2 class="acard__title">{{ article.title }}</h2>
              <p class="acard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <span class="acard__meta">{{ article.published_at | date: '%-d %b %Y' }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}<a class="pagination__link" href="{{ paginate.previous.url }}">← {{ 'showroom.prev' | t: default: 'Föregående' }}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="pagination__link is-current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a class="pagination__link" href="{{ paginate.next.url }}">{{ 'showroom.next' | t: default: 'Nästa' }} →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" }
  ]
}
{% endschema %}
