{%- liquid
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
-%}
<header class="site-header" {% if is_home %}data-overlay data-header-overlay{% else %}data-solid{% endif %}>
  <div class="container site-header__row">
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
      {%- render 'bee-mark' -%}
      <span class="brand__word">{{ shop.name | default: 'EMOTO' }}<span class="brand__dot">.</span></span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <a href="{{ routes.cart_url }}" class="site-header__cart" aria-label="{{ 'general.cart' | t: default: 'Cart' }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H3"/></svg>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
