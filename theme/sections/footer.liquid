{%- comment -%} EMOTO — footer {%- endcomment -%}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      {%- comment -%} Brand + newsletter {%- endcomment -%}
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }}">
          {%- render 'bee-mark' -%}
          <span class="brand__word">{{ shop.name | default: 'EMOTO' }}<span class="brand__dot">.</span></span>
        </a>
        <p class="site-footer__tag">{{ section.settings.tagline | default: 'Premium elektriska off-road- och gaturegistrerade motorcyklar. Byggda för Norden.' }}</p>

        {%- if section.settings.show_newsletter -%}
          <form method="post" action="/contact#newsletter" class="site-footer__news" accept-charset="UTF-8">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="site-footer__news-label" for="footer-email">{{ section.settings.newsletter_heading | default: 'Håll dig uppdaterad' }}</label>
            <div class="site-footer__news-row">
              <input id="footer-email" type="email" name="contact[email]" required
                     placeholder="{{ section.settings.newsletter_placeholder | default: 'Din e-post' }}" class="site-footer__news-input">
              <button type="submit" class="btn-signal" aria-label="{{ section.settings.newsletter_button | default: 'Prenumerera' }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            {%- if section.settings.newsletter_note != blank -%}
              <p class="site-footer__news-note">{{ section.settings.newsletter_note }}</p>
            {%- endif -%}
          </form>
        {%- endif -%}

        {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank or settings.social_tiktok != blank -%}
          <div class="site-footer__social">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8z"/></svg></a>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M11 9.5l4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 4v9a3.5 3.5 0 1 1-3-3.46"/><path d="M14 4c.5 2.2 2 3.6 4 3.9"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      <nav class="site-footer__col" aria-label="{{ 'footer.models' | t: default: 'Models' }}">
        <h3 class="site-footer__heading">{{ 'footer.models' | t: default: 'Modeller' }}</h3>
        <a href="{{ routes.root_url }}collections/modeller">{{ 'collection.all' | t: default: 'Alla modeller' }}</a>
        <a href="{{ routes.root_url }}products/ultra-bee">Ultra Bee</a>
        <a href="{{ routes.root_url }}products/light-bee-x">Light Bee X</a>
        <a href="{{ routes.root_url }}products/storm-bee">Storm Bee</a>
      </nav>

      <nav class="site-footer__col" aria-label="{{ 'footer.company' | t: default: 'Company' }}">
        <h3 class="site-footer__heading">{{ 'footer.company' | t: default: 'Företag' }}</h3>
        {%- if section.settings.about_page != blank -%}<a href="{{ section.settings.about_page.url }}">{{ section.settings.about_page.title }}</a>{%- else -%}<a href="{{ routes.root_url }}pages/om-oss">{{ 'footer.about' | t: default: 'Om EMOTO' }}</a>{%- endif -%}
        <a href="{{ routes.root_url }}blogs/journal">{{ 'footer.journal' | t: default: 'Journal' }}</a>
        <a href="{{ routes.root_url }}pages/kontakt">{{ 'footer.contact' | t: default: 'Kontakt' }}</a>
      </nav>

      <nav class="site-footer__col" aria-label="{{ 'footer.support' | t: default: 'Support' }}">
        <h3 class="site-footer__heading">{{ 'footer.support' | t: default: 'Kundservice' }}</h3>
        <a href="{{ routes.root_url }}pages/leverans">{{ 'footer.delivery' | t: default: 'Leverans' }}</a>
        <a href="{{ routes.root_url }}pages/delbetalning">{{ 'footer.financing' | t: default: 'Delbetalning' }}</a>
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
        {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
      </nav>
    </div>

    {%- if section.settings.show_payments -%}
      <div class="site-footer__pay" aria-label="{{ 'footer.payments' | t: default: 'Payment methods' }}">
        {%- assign methods = 'Klarna,Qliro,Swish,Visa,Mastercard,Apple Pay' | split: ',' -%}
        {%- for m in methods -%}<span class="pay-badge">{{ m }}</span>{%- endfor -%}
      </div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.note }}</p>
      <p class="site-footer__legal">{{ 'footer.independent' | t: default: 'Oberoende återförsäljare. Sur-Ron är ett varumärke som tillhör respektive ägare.' }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Brand tagline", "default": "Premium elektriska off-road- och gaturegistrerade motorcyklar. Byggda för Norden." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Håll dig uppdaterad" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder", "default": "Din e-post" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Prenumerera" },
    { "type": "text", "id": "newsletter_note", "label": "Note", "default": "Nyheter, släpp och erbjudanden. Avsluta när du vill." },
    { "type": "header", "content": "Company links" },
    { "type": "page", "id": "about_page", "label": "About page (optional)" },
    { "type": "header", "content": "Payments & legal" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment badges", "default": true },
    { "type": "text", "id": "note", "label": "Copyright note", "default": "Alla rättigheter förbehållna." }
  ]
}
{% endschema %}
