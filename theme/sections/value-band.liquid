{%- comment -%} EMOTO — reusable value band (financing, concierge, etc.) {%- endcomment -%}
<section class="vband{% if section.settings.dark %} vband--dark{% endif %}">
  <div class="container vband__inner">
    <div class="vband__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vband__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="vband__body">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn-signal vband__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="vband__list">
        {%- for block in section.blocks -%}
          <li class="vband__point" {{ block.shopify_attributes }}>
            <span class="vband__check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l4 4 10-10"/></svg>
            </span>
            <div>
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.body != blank -%}<span>{{ block.settings.body }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Value band",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Delbetalning" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kör nu. Betala i din takt." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Dela upp betalningen med Klarna eller Qliro — direkt i kassan. Välj mellan att betala senare eller upp till 36 månaders delbetalning." },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Klarna & Qliro" },
        { "type": "text", "id": "body", "label": "Body", "default": "Betala senare eller dela upp" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Value band — financing",
      "settings": {
        "eyebrow": "Delbetalning",
        "heading": "Kör nu. Betala i din takt.",
        "body": "Dela upp betalningen med Klarna eller Qliro — direkt i kassan. Välj mellan att betala senare eller upp till 36 månaders delbetalning."
      },
      "blocks": [
        { "type": "point", "settings": { "title": "Från 0 % ränta", "body": "Kampanjperioder via Klarna" } },
        { "type": "point", "settings": { "title": "Upp till 36 mån", "body": "Sprid ut kostnaden" } },
        { "type": "point", "settings": { "title": "Direkt besked", "body": "Ansök i kassan på sekunder" } }
      ]
    }
  ]
}
{% endschema %}
