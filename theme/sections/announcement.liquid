{%- comment -%} EMOTO — announcement bar (rotating value props) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="announce" data-announce role="region" aria-label="{{ 'general.announcement' | t: default: 'Announcements' }}">
  <div class="container announce__inner">
    {%- for block in section.blocks -%}
      <div class="announce__item{% if forloop.first %} is-active{% endif %}" data-announce-item {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- if section.blocks.size > 1 -%}
<script>
  (function () {
    var bar = document.querySelector('[data-announce]');
    if (!bar) return;
    var items = bar.querySelectorAll('[data-announce-item]');
    if (items.length < 2) return;
    var i = 0;
    setInterval(function () {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, {{ section.settings.interval | default: 4 | times: 1000 }});
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "interval", "min": 3, "max": 8, "step": 1, "unit": "s", "label": "Rotation interval", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fri leverans inom EU" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Fri leverans inom hela EU — DDP, inga överraskningar" } },
        { "type": "message", "settings": { "text": "Delbetalning från 0 % ränta via Klarna & Qliro" } },
        { "type": "message", "settings": { "text": "Registreringshjälp ingår — vi gör din maskin vägklar" } }
      ]
    }
  ]
}
{% endschema %}
