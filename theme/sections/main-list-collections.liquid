{%- comment -%} EMOTO — all collections {%- endcomment -%}
<section class="collection">
  <div class="container">
    <header class="collection__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Sortiment' }}</span>
      <h1 class="collection__title">{{ section.settings.heading | default: 'Kategorier' }}</h1>
    </header>
    <div class="collection__grid">
      {%- for collection in collections -%}
        <a class="ccard" href="{{ collection.url }}">
          <div class="ccard__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: collection.title, class: 'ccard__img' }}
            {%- endif -%}
          </div>
          <div class="ccard__body">
            <h2 class="ccard__title">{{ collection.title }}</h2>
            <span class="ccard__count">{{ collection.all_products_count }} {{ 'collection.items' | t: default: 'produkter' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "All collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sortiment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kategorier" }
  ]
}
{% endschema %}
