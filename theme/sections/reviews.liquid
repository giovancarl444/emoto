{%- comment -%} EMOTO — reviews / social proof (dark) {%- endcomment -%}
{%- comment -%} Renders only when the merchant has added real review blocks — nothing fabricated ships by default. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="reviews">
  <div class="reviews__comb" aria-hidden="true"></div>
  <div class="container reviews__inner">
    <header class="reviews__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Omdömen' }}</span>
      <h2 class="reviews__title">{{ section.settings.heading | default: 'Förare litar på EMOTO' }}</h2>
      <div class="reviews__badge">{% render 'trustpilot', tone: 'light' %}</div>
    </header>

      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          <figure class="rcard" {{ block.shopify_attributes }}>
            <div class="rcard__stars" aria-label="{{ block.settings.rating | default: 5 }}/5">
              {%- for i in (1..5) -%}
                <span class="rcard__star{% if forloop.index <= block.settings.rating %} is-on{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01z"/></svg></span>
              {%- endfor -%}
            </div>
            <blockquote class="rcard__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="rcard__by">
              <span class="rcard__name">{{ block.settings.name }}</span>
              {%- if block.settings.detail != blank -%}<span class="rcard__detail">{{ block.settings.detail }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Omdömen" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Förare litar på EMOTO" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Lägg till en verifierad kundrecension här." },
        { "type": "text", "id": "name", "label": "Name", "default": "Förnamn E." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Modell · Stad" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "Lägg till en verifierad kundrecension här — ersätt platshållaren med ett riktigt omdöme.", "name": "Förnamn E.", "detail": "Modell · Stad" } }
      ]
    }
  ]
}
{% endschema %}
