{%- comment -%} EMOTO — coming soon / password gate {%- endcomment -%}
<main class="coming">
  <div class="coming__atmos" aria-hidden="true">
    <div class="showroom__grad"></div>
    <div class="showroom__comb"></div>
    <div class="showroom__glow"></div>
  </div>

  <div class="coming__inner">
    <div class="coming__mark">{% render 'bee-mark' %}</div>
    <span class="coming__word">{{ shop.name | default: 'EMOTO' }}</span>

    <h1 class="coming__title">{{ section.settings.heading | default: 'Något elektriskt är på väg.' }}</h1>
    <p class="coming__body">{{ section.settings.body | default: 'Premium elektriska off-road- och gaturegistrerade motorcyklar. Byggda för Norden. Öppnar snart.' }}</p>

    {%- if section.settings.show_signup -%}
      <div class="coming__signup">
        {%- form 'customer', class: 'coming__form' -%}
          <input type="hidden" name="contact[tags]" value="prospect, coming-soon">
          <input type="email" name="contact[email]" required
                 placeholder="{{ section.settings.signup_placeholder | default: 'Din e-post' }}"
                 class="coming__input" aria-label="{{ 'footer.newsletter' | t: default: 'E-post' }}">
          <button type="submit" class="btn-signal">{{ section.settings.signup_button | default: 'Notifiera mig' }}</button>
          {%- if form.posted_successfully? -%}
            <p class="coming__ok">{{ section.settings.signup_success | default: 'Tack! Vi hör av oss.' }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="coming__enter">
      <details class="coming__lock">
        <summary>{{ 'general.password_prompt' | t: default: 'Ange lösenord' }}</summary>
        {%- form 'storefront_password', class: 'coming__pwform' -%}
          {%- if form.errors -%}<p class="coming__err">{{ form.errors | default_errors }}</p>{%- endif -%}
          <input type="password" name="password" class="coming__input"
                 placeholder="{{ 'general.password_prompt' | t: default: 'Lösenord' }}" aria-label="Password">
          <button type="submit" class="btn-ghost btn-ghost--onDark">{{ 'general.enter' | t: default: 'Gå in' }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "Coming soon",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Något elektriskt är på väg." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Premium elektriska off-road- och gaturegistrerade motorcyklar. Byggda för Norden. Öppnar snart." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_placeholder", "label": "Email placeholder", "default": "Din e-post" },
    { "type": "text", "id": "signup_button", "label": "Signup button", "default": "Notifiera mig" },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "Tack! Vi hör av oss." }
  ]
}
{% endschema %}
