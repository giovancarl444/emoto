# ─────────────────────────────────────────────────────────────
# ELDR storefront — environment template
# Copy to .env.local and fill in. With NO Shopify vars set, the app
# runs in MOCK mode against content/ seed data so `npm run dev` works
# out of the box. Set the Shopify vars to wire the real backend.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical, hreflang, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://eldr.se

# ── Shopify Storefront API (commerce backend) ──
# Create a custom app in Shopify admin → Apps → Develop apps → Storefront API.
# Leave blank to run in MOCK mode (seed data from /content).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# ── Analytics / consent (GA4, consent-mode gated by cookie banner) ──
NEXT_PUBLIC_GA4_ID=

# ── Feature flags ──
# 'mock' forces seed data even if Shopify vars are present; 'auto' uses
# Shopify when configured and falls back to mock otherwise.
NEXT_PUBLIC_COMMERCE_MODE=auto
