{%- comment -%}
  EMOTO — Trustpilot-style rating badge.
  Params: rating (default settings), count, tone ('light' on dark bg / 'dark' on light bg), compact (bool)
{%- endcomment -%}
{%- liquid
  assign r = rating | default: settings.trustpilot_rating | default: 4.8
  assign c = count | default: settings.trustpilot_count | default: 127
  assign full = r | floor
-%}
<a class="tpilot tpilot--{{ tone | default: 'light' }}{% if compact %} tpilot--compact{% endif %}"
   href="{{ settings.trustpilot_url | default: '#' }}"{% if settings.trustpilot_url != blank %} target="_blank" rel="noopener"{% endif %}
   aria-label="Trustpilot {{ r }} av 5, {{ c }} recensioner">
  <span class="tpilot__stars" style="--tp-full: {{ full }};">
    {%- for i in (1..5) -%}
      <span class="tpilot__star{% if forloop.index <= full %} is-on{% endif %}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01z"/></svg>
      </span>
    {%- endfor -%}
  </span>
  <span class="tpilot__meta">
    <strong class="tpilot__brand"><svg class="tpilot__logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01z"/></svg>Trustpilot</strong>
    <span class="tpilot__score">{{ r }} · {{ c }} {{ 'reviews.count' | t: default: 'recensioner' }}</span>
  </span>
</a>
