<section class="feature">
  <div class="feature__comb" aria-hidden="true"></div>
  <div class="feature__glow" aria-hidden="true"></div>
  {%- if section.settings.image != blank -%}
    <div class="feature__bike" aria-hidden="true">{{ section.settings.image | image_url: width: 1400 | image_tag: alt: '' }}</div>
  {%- elsif section.settings.product != blank and section.settings.product.featured_media != blank -%}
    <div class="feature__bike" aria-hidden="true">{{ section.settings.product.featured_media | image_url: width: 1400 | image_tag: alt: '' }}</div>
  {%- else -%}
    <div class="feature__bike" aria-hidden="true"><img src="{{ 'ultra-bee.png' | asset_url }}" alt="" width="803" height="429"></div>
  {%- endif -%}
  <div class="feature__scrim" aria-hidden="true"></div>

  <div class="container feature__inner">
    <div class="feature__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="feature__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="feature__body">{{ section.settings.body }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <dl class="feature__specs">
          {%- for block in section.blocks -%}
            <div class="feature__spec" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.value }}</dt>
              <dd>{{ block.settings.label }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="feature__cta">
          <a class="btn-signal" href="{% if section.settings.product != blank %}{{ section.settings.product.url }}{% else %}{{ section.settings.cta_url | default: '#' }}{% endif %}">
            {{ section.settings.cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="feature__mobile">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading }}
      {%- elsif section.settings.product != blank and section.settings.product.featured_media != blank -%}
        {{ section.settings.product.featured_media | image_url: width: 1200 | image_tag: alt: section.settings.heading }}
      {%- else -%}
        <img src="{{ 'ultra-bee.png' | asset_url }}" alt="{{ section.settings.heading }}" width="803" height="429">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature spotlight",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Flaggskeppet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Byggd för både asfalt och lera." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Ultra Bee kombinerar riktig enduro-geometri med ett 74-volts batteri för längre pass. Den gaturegistrerade L3e-versionen tar dig lagligt till jobbet på vardagen — och rakt ut i skogen på helgen." },
    { "type": "image_picker", "id": "image", "label": "Bike image (transparent PNG)" },
    { "type": "product", "id": "product", "label": "Linked product (CTA)" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Utforska Ultra Bee" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "≈21 kW" },
        { "type": "text", "id": "label", "label": "Label", "default": "Toppeffekt" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature spotlight",
      "blocks": [
        { "type": "spec", "settings": { "value": "≈21 kW", "label": "Toppeffekt" } },
        { "type": "spec", "settings": { "value": "140 km", "label": "Räckvidd" } },
        { "type": "spec", "settings": { "value": "74V · 55Ah", "label": "Batteri" } },
        { "type": "spec", "settings": { "value": "≈90 km/h", "label": "Toppfart" } }
      ]
    }
  ]
}
{% endschema %}
