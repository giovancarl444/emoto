{%- comment -%} EMOTO — related products (cross-sell on PDP) {%- endcomment -%}
{%- liquid
  assign source = collections[section.settings.collection]
  if source == blank or source.products.size == 0
    assign source = product.collections.first
  endif
-%}
{%- if source != blank and source.products.size > 1 -%}
<section class="related">
  <div class="container">
    <header class="related__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Fler modeller' }}</span>
      <h2 class="related__title">{{ section.settings.heading | default: 'Du kanske också gillar' }}</h2>
    </header>
    <div class="collection__grid">
      {%- assign shown = 0 -%}
      {%- for p in source.products -%}
        {%- if p.id != product.id and shown < 3 -%}
          {%- render 'product-card', card_product: p, index: forloop.index0 -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fler modeller" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Du kanske också gillar" },
    { "type": "collection", "id": "collection", "label": "Source collection (defaults to product's collection)" }
  ]
}
{% endschema %}
