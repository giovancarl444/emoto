{%- comment -%} EMOTO — trust strip (below hero) {%- endcomment -%}
<section class="tstrip">
  <div class="container tstrip__row">
    {%- for block in section.blocks -%}
      <div class="tstrip__item" {{ block.shopify_attributes }}>
        <span class="tstrip__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
            {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'doc' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h9l3 3v15H6z"/><path d="M9 9h6M9 13h6M9 17h4"/></svg>
            {%- when 'card' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
          {%- endcase -%}
        </span>
        <div class="tstrip__txt">
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.subtitle }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "doc", "label": "Document" },
            { "value": "card", "label": "Card" },
            { "value": "check", "label": "Check" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Fri leverans" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Inom hela EU (DDP)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Fri leverans", "subtitle": "Inom hela EU (DDP)" } },
        { "type": "item", "settings": { "icon": "shield", "title": "2 års garanti", "subtitle": "Fabriks- & servicegaranti" } },
        { "type": "item", "settings": { "icon": "doc", "title": "Registreringshjälp", "subtitle": "Vi ordnar pappersarbetet" } },
        { "type": "item", "settings": { "icon": "card", "title": "Delbetalning", "subtitle": "Från 0 % ränta via Klarna" } }
      ]
    }
  ]
}
{% endschema %}
