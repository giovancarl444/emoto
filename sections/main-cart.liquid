{%- comment -%} EMOTO — cart {%- endcomment -%}
<section class="cart">
  <div class="container">
    <h1 class="cart__title">{{ 'cart.title' | t: default: 'Din varukorg' }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart, class: 'cart__form' -%}
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart__item">
              <a href="{{ item.url }}" class="cart__thumb">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy', widths: '100, 200' }}
                {%- endif -%}
              </a>
              <div class="cart__meta">
                <a href="{{ item.url }}" class="cart__name">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <span class="cart__variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <span class="cart__unit">{{ item.original_price | money }}</span>
              </div>
              <div class="cart__qty">
                <label class="visually-hidden" for="qty-{{ item.index | plus: 1 }}">{{ 'cart.quantity' | t: default: 'Antal' }}</label>
                <input id="qty-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" class="cart__qty-input">
                <a class="cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t: default: 'Ta bort' }}</a>
              </div>
              <div class="cart__line">{{ item.final_line_price | money }}</div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart__foot">
          <div class="cart__summary">
            <div class="cart__subtotal">
              <span>{{ 'cart.subtotal' | t: default: 'Delsumma' }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <p class="cart__note">{{ 'cart.taxes_note' | t: default: 'Frakt och moms beräknas i kassan.' }}</p>
            <div class="cart__actions">
              <button type="submit" name="update" class="btn-ghost">{{ 'cart.update' | t: default: 'Uppdatera' }}</button>
              <button type="submit" name="checkout" class="btn-action">{{ 'cart.checkout' | t: default: 'Till kassan' }}</button>
            </div>
          </div>
        </div>
      {%- endform -%}
    {%- else -%}
      <div class="cart__empty">
        <p>{{ 'cart.empty' | t: default: 'Din varukorg är tom.' }}</p>
        <a class="btn-signal" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t: default: 'Fortsätt handla' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
