{%- comment -%} EMOTO — collection listing {%- endcomment -%}
<section class="collection">
  <div class="container">
    <header class="collection__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Modeller' }}</span>
      <h1 class="collection__title">{{ collection.title | default: 'Alla modeller' }}</h1>
      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="collection__desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 12 -%}
        <div class="collection__grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', card_product: product, index: forloop.index0 -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation">
            {%- if paginate.previous -%}<a class="pagination__link" href="{{ paginate.previous.url }}">← {{ 'showroom.prev' | t: default: 'Föregående' }}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="pagination__link is-current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a class="pagination__link" href="{{ paginate.next.url }}">{{ 'showroom.next' | t: default: 'Nästa' }} →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="collection__empty">{{ 'collection.empty' | t: default: 'Inga produkter hittades.' }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Modeller" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true }
  ]
}
{% endschema %}
