{%- comment -%} EMOTO — model lineup grid {%- endcomment -%}
<section class="lineup">
  <div class="container">
    <header class="lineup__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Sortimentet' }}</span>
      <h2 class="lineup__title">{{ section.settings.heading | default: 'Hela flottan' }}</h2>
      {%- if section.settings.body != blank -%}<p class="lineup__body">{{ section.settings.body }}</p>{%- endif -%}
    </header>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="collection__grid">
        {%- for product in section.settings.collection.products limit: 6 -%}
          {%- render 'product-card', card_product: product, index: forloop.index0 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="collection__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign monthly = block.settings.price | divided_by: 36
            assign url = block.settings.link | default: '#'
            if block.settings.product != blank
              assign url = block.settings.product.url
            endif
          -%}
          <a class="pcard" href="{{ url }}" {{ block.shopify_attributes }}>
            <div class="pcard__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: block.settings.name, class: 'pcard__img' }}
              {%- else -%}
                <img class="pcard__img" src="{{ 'ultra-bee.png' | asset_url }}" alt="{{ block.settings.name }}" width="803" height="429" loading="lazy">
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="pcard__flag">{{ block.settings.badge }}</span>{%- endif -%}
            </div>
            <div class="pcard__body">
              {%- if block.settings.marque != blank -%}<span class="pcard__vendor">{{ block.settings.marque }}</span>{%- endif -%}
              <h3 class="pcard__title">{{ block.settings.name }}</h3>
              {%- if block.settings.tagline != blank -%}<p class="pcard__fin">{{ block.settings.tagline }}</p>{%- endif -%}
              <div class="pcard__pricerow">
                <span class="pcard__price">{{ 'product.from' | t: default: 'Från' }} {{ block.settings.price | times: 100 | money_without_trailing_zeros }}</span>
              </div>
              <span class="pcard__fin">{{ 'product.or' | t: default: 'eller' }} {{ monthly | times: 100 | money_without_trailing_zeros }}/{{ 'product.month' | t: default: 'mån' }}</span>
              <span class="pcard__cta">{{ 'product.view' | t: default: 'Se modellen' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Model lineup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sortimentet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hela flottan" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Tre maskiner, ett DNA. Välj din väg — från lätt enduro till gaturegistrerad kraft." },
    { "type": "collection", "id": "collection", "label": "Collection (optional — overrides manual models below)" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Model",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (transparent PNG)" },
        { "type": "text", "id": "marque", "label": "Marque", "default": "Sur-Ron" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ultra Bee" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Stadsgodkänd. Terrängfödd." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Mest mångsidig" },
        { "type": "number", "id": "price", "label": "From price (SEK)", "default": 64900 },
        { "type": "url", "id": "link", "label": "Link (if no product)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Model lineup",
      "blocks": [
        { "type": "model", "settings": { "name": "Light Bee X", "marque": "Sur-Ron", "tagline": "Ren elektrisk enduro. Runt 50 kg.", "badge": "Lättast", "price": 54900 } },
        { "type": "model", "settings": { "name": "Ultra Bee", "marque": "Sur-Ron", "tagline": "Stadsgodkänd. Terrängfödd.", "badge": "Mest mångsidig", "price": 64900 } },
        { "type": "model", "settings": { "name": "Storm Bee", "marque": "Sur-Ron", "tagline": "Vätskekyld. 0–50 km/h på 1,9 s.", "badge": "Starkast", "price": 99900 } }
      ]
    }
  ]
}
{% endschema %}
