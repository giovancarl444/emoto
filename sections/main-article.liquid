{%- comment -%} EMOTO — article {%- endcomment -%}
<article class="article">
  <div class="container article__narrow">
    <header class="article__head">
      {%- if article.tags.size > 0 -%}<span class="eyebrow">{{ article.tags.first }}</span>{%- endif -%}
      <h1 class="article__title">{{ article.title }}</h1>
      <div class="article__meta">
        <span>{{ article.published_at | date: '%-d %B %Y' }}</span>
        {%- if article.author != blank -%}<span>· {{ article.author }}</span>{%- endif -%}
      </div>
    </header>

    {%- if article.image -%}
      <div class="article__hero">
        {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', alt: article.title, class: 'article__hero-img' }}
      </div>
    {%- endif -%}

    <div class="article__body rte">
      {{ article.content }}
    </div>

    {%- if blog.next_article or blog.previous_article -%}
      <nav class="article__nav">
        {%- if blog.previous_article -%}<a href="{{ blog.previous_article.url }}">← {{ blog.previous_article.title }}</a>{%- endif -%}
        {%- if blog.next_article -%}<a href="{{ blog.next_article.url }}" class="article__nav-next">{{ blog.next_article.title }} →</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": { "@type": "Organization", "name": {{ article.author | default: shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  {%- if article.image -%},"image": "{{ article.image | image_url: width: 1200 | prepend: 'https:' }}"{%- endif -%}
}
</script>

{% schema %}
{ "name": "Article", "tag": "section", "settings": [] }
{% endschema %}
